{
  "name": "@metaharness/host-codex",
  "version": "0.1.4",
  "description": "OpenAI Codex CLI host adapter for MetaHarness: writes the MCP server entry for ~/.codex/config.toml from a harness spec.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/host-codex"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "metaharness",
    "agent-harness",
    "openai-codex",
    "codex",
    "codex-cli",
    "mcp",
    "model-context-protocol",
    "host-adapter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metaharness/kernel": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
