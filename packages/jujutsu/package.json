{
  "name": "@metaharness/jujutsu",
  "version": "0.2.1",
  "description": "Version control for agents in MetaHarness: wraps agentic-jujutsu (jj op-log, lock-free coordination, signed trajectories) and bridges it to agenticow copy-on-write memory branches.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/jujutsu"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke": "node smoke.mjs"
  },
  "keywords": [
    "metaharness",
    "jujutsu",
    "jj",
    "version-control",
    "op-log",
    "lock-free",
    "agent-coordination",
    "agent-memory",
    "copy-on-write",
    "agenticow",
    "agent-harness"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "agenticow": "^0.2.0",
    "agentic-jujutsu": "^2.3.6"
  },
  "peerDependenciesMeta": {
    "agenticow": {
      "optional": true
    },
    "agentic-jujutsu": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
