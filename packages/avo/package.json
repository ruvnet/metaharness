{
  "name": "@metaharness/avo",
  "version": "0.1.2",
  "description": "Governed autonomous variation runtime: evidence-driven repository engineering loops with bounded authority, replayable receipts, semantic supervision, and RVF working memory.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "benchmark:swebench": "npm run build && node bench/swebench-three-arm.mjs",
    "pack:verify": "npm pack --dry-run"
  },
  "keywords": [
    "agentic-variation",
    "long-horizon",
    "evolutionary-search",
    "rvf",
    "swe-bench",
    "metaharness"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@metaharness/horizon": "^0.2.0"
  },
  "peerDependencies": {
    "agenticow": "^0.2.3"
  },
  "peerDependenciesMeta": {
    "agenticow": {
      "optional": true
    }
  },
  "devDependencies": {
    "agenticow": "^0.2.3",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
