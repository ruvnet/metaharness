{
  "name": "@metaharness/energy",
  "version": "0.1.0",
  "description": "Experimental bounded pairwise energy search and independently validated agent assignment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/**", "README.md", "VALIDATION-v2.md", "bench/**", "LICENSE"],
