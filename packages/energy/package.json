    "benchmark:generic": "node bench/generic-search.mjs"
  },
  "repository": { "type": "git", "url": "https://github.com/ruvnet/metaharness.git", "directory": "packages/energy" },
  "homepage": "https://ruv.io",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "devDependencies": { "typescript": "^5.4.0", "vitest": "^4.1.12" }
