{
  "name": "@metaharness/host-github-actions",
  "version": "0.1.5",
  "description": "GitHub Actions host adapter for MetaHarness: emits a least-privilege workflow and a reusable composite action so an agent harness runs non-interactively in CI.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/host-github-actions"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "metaharness",
    "agent-harness",
    "github-actions",
    "ci-cd",
    "continuous-integration",
    "agent-evaluation",
    "harness-evaluation",
    "composite-action",
    "workflow",
    "host-adapter",
    "least-privilege",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metaharness/kernel": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
