{
  "name": "@metaharness/aws-finops",
  "version": "0.1.1",
  "description": "Darwin FinOps harness: cheap models propose Terraform patches and a deterministic cost oracle (infracost, checkov, terraform plan) reports only verified AWS savings behind a review gate.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/aws-finops"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "bench": "npm run build && node bench/run-all.mjs"
  },
  "keywords": [
    "metaharness",
    "darwin-mode",
    "finops",
    "aws",
    "terraform",
    "infracost",
    "checkov",
    "cost-optimization",
    "deterministic-oracle",
    "agent-harness"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
