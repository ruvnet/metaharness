{
  "name": "@metaharness/workspace-probe",
  "version": "0.1.2",
  "description": "Evaluation bridge for @metaharness/workspace-lens: turns interpretability receipts into a flywheel workspace_probe score and rejects brittle prompt or policy mutations.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/workspace-probe"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "metaharness",
    "workspace-lens",
    "jacobian-lens",
    "interpretability",
    "darwin-mode",
    "flywheel",
    "evaluation",
    "ai-safety",
    "agent-harness"
  ],
  "license": "MIT",
  "dependencies": {
    "@metaharness/workspace-lens": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "bin": {
    "workspace-probe": "./bin/workspace-probe.mjs"
  }
}
