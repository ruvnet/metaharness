{
  "name": "@ruvnet/agent-harness-generator",
  "version": "0.1.4",
  "description": "Library API for the MetaHarness generator: import scaffold(), validateHarnessName(), HOSTS and TEMPLATES from code instead of shelling out to the metaharness CLI.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/agent-harness-generator-lib"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "license": "MIT",
  "author": "rUv <ruv@ruv.net>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "agent-harness",
    "agent-harness-generator",
    "metaharness",
    "scaffold",
    "mcp-server",
    "claude-code",
    "codex",
    "library"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "metaharness": "0.4.22"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
