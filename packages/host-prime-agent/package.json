{
  "name": "@metaharness/host-prime-agent",
  "version": "0.1.1",
  "description": "Prime Agent (PrimeIntellect) host adapter for MetaHarness: emits project-scoped Python-backed skills from a harness spec.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/host-prime-agent"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "license": "MIT",
  "type": "module",
