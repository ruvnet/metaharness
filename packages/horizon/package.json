{
  "name": "@metaharness/horizon",
  "version": "0.2.0",
  "description": "Deterministic long-horizon control with Rust/WASM halt and command guards, real tool execution receipts, full checkpoints, and flush-before-compaction.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path crate/Cargo.toml --release",
    "demo": "node scripts/demo.mjs",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "long-horizon",
    "adk",
    "halt-controller",
    "command-guard",
    "context-compaction",
    "wasm-sandbox",
    "agent-harness",
    "metaharness"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
