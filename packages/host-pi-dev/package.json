{
  "name": "@metaharness/host-pi-dev",
  "version": "0.1.4",
  "description": "pi.dev coding-agent host adapter for MetaHarness: emits a Pi extension and AGENTS.md from a harness spec (no MCP, by design).",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/host-pi-dev"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "metaharness",
    "agent-harness",
    "pi-dev",
    "pi-coding-agent",
    "coding-agent",
    "agents-md",
    "host-adapter",
    "extension"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metaharness/kernel": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
