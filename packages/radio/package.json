{
  "name": "@metaharness/radio",
  "version": "0.1.1",
  "description": "Passive-awareness bus for agent pods: threads, non-blocking mentions and background watchers that fold teammate discoveries in at step boundaries (AgentRadio).",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/radio"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "flywheel": "node scripts/flywheel-radio.mjs"
  },
  "keywords": [
    "metaharness",
    "multi-agent",
    "swarm",
    "agent-communication",
    "passive-awareness",
    "message-bus",
    "agent-harness",
    "agentradio"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  }
}
