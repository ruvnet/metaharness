{
  "name": "@metaharness/flywheel",
  "version": "0.1.15",
  "description": "Verifiable self-improvement loop for agent harnesses: run candidates, compare against a frozen baseline, and promote only what proves lift, with signed receipts and lineage.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/flywheel"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cjs/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && npm run build:cjs",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "verify:dual": "npm run build && node scripts/verify-dual.mjs"
  },
  "keywords": [
    "metaharness",
    "agent-harness",
    "self-improvement",
    "flywheel",
    "promotion-gate",
    "lineage",
    "receipts",
    "evaluation",
    "ai-agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  }
}
