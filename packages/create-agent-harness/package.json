{
  "name": "metaharness",
  "version": "0.4.23",
  "description": "Scaffold, check and score a custom AI agent harness for Claude Code, Codex, Copilot, GitHub Actions and six more hosts: `npx metaharness new <name>`, then `harness doctor` and `harness score`.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/create-agent-harness"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "license": "MIT",
  "author": "rUv <ruv@ruv.net>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "metaharness": "dist/bin.js",
    "harness": "dist/harness-bin.js"
  },
  "files": [
    "dist/**",
    "templates/**",
    "assets/**",
    "genomes/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "gen:templates": "node scripts/gen-templates.mjs"
  },
  "keywords": [
    "metaharness",
    "agent-harness",
    "ai-agent",
    "agent-scaffold",
    "scaffold",
    "cli",
    "npx",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "github-copilot",
    "github-actions",
    "pi-dev",
    "hermes-agent",
    "openclaw",
    "harness-evaluation",
    "agent-evaluation",
    "sbom",
    "provenance"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "kolorist": "^1.8.0",
    "prompts": "^2.4.2",
    "@metaharness/darwin": "0.13.1",
    "@metaharness/weight-eft": "0.1.3",
    "@metaharness/redblue": "0.1.7",
    "@metaharness/flywheel": "0.1.14",
    "@metaharness/turn-credit": "0.1.1",
    "@metaharness/avo": "0.2.1"
  },
  "peerDependencies": {
    "@metaharness/kernel": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@metaharness/kernel": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@ruvector/ruvllm": "^4.1.0"
  }
}
