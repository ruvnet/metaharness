{
  "name": "@metaharness/darwin",
  "version": "0.13.1",
  "description": "Freeze the model, evolve the harness: Darwin Mode mutates an agent harness's policy, runs each child in a sandbox, and promotes only children that beat the parent on a deterministic oracle.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/darwin-mode"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "metaharness-darwin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gepa": {
      "types": "./dist/gepa/index.d.ts",
      "import": "./dist/gepa/index.js"
    },
    "./contrastive": {
      "types": "./dist/contrastive/index.d.ts",
      "import": "./dist/contrastive/index.js"
    }
  },
  "files": [
    "dist/**",
    "genomes/**",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "LEARNINGS.md",
    "CONTRASTIVE.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "bench:shield": "npm run build && node bench/security/darwin-shield-bench.mjs",
    "bench:clade": "npm run build && node bench/selection/clade-throughput.mjs",
    "bench:contrastive": "npm run build && node bench/contrastive/run.mjs"
  },
  "keywords": [
    "metaharness",
    "darwin-mode",
    "agent-harness",
    "evolutionary-search",
    "self-improvement",
    "swe-bench",
    "code-repair",
    "model-cascade",
    "cost-optimization",
    "sandbox",
    "llm",
    "ai-agent"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@metaharness/flywheel": "^0.1.1",
    "agenticow": "^0.2.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^7.29.13"
  }
}
