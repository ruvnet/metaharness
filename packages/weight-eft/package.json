{
  "name": "@metaharness/weight-eft",
  "version": "0.1.3",
  "description": "Fine-tune cheap open models on your coding agent's successful runs with LoRA (SFT + DPO) so the cascade escalates to frontier models less often. Exports TRL/axolotl JSONL with contamination guards.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/weight-eft"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "weight-eft": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "metaharness",
    "lora",
    "fine-tuning",
    "peft",
    "sft",
    "dpo",
    "model-distillation",
    "model-cascade",
    "coding-agent",
    "training-data",
    "jsonl",
    "trl",
    "axolotl",
    "cost-optimization",
    "llm"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
