{
  "name": "@metaharness/projects",
  "version": "0.1.3",
  "description": "Borrowed-pattern program for Darwin Mode: durable checkpoints, cost-attributing traces, declarative HarnessSpec, tiered memory, typed handoffs, safety rails and human review gates.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/projects"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "bench": "npm run build && node bench/run-all.mjs"
  },
  "keywords": [
    "metaharness",
    "darwin-mode",
    "agent-harness",
    "durable-execution",
    "tracing",
    "cost-optimization",
    "guardrails",
    "policy-mutation",
    "human-review"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
