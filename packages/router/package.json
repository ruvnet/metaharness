{
  "name": "@metaharness/router",
  "version": "0.4.1",
  "description": "Cost-optimal model router for agent harnesses: sends each query to the cheapest model that is good enough, using k-NN over labelled embeddings.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/router"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "bench": "npm run build && node bench/route-throughput.mjs"
  },
  "keywords": [
    "metaharness",
    "model-routing",
    "llm-routing",
    "llm-router",
    "cost-optimization",
    "agent-harness",
    "knn",
    "embeddings",
    "draco",
    "llm"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@ruvector/tiny-dancer": "^0.1.21",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@ruvector/tiny-dancer": "^0.1.21"
  },
  "peerDependenciesMeta": {
    "@ruvector/tiny-dancer": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
