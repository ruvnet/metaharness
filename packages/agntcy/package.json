{
  "name": "@metaharness/agntcy",
  "version": "0.1.2",
  "description": "AGNTCY build-time integration for MetaHarness agents: DID identity badges, OASF capability records, Agent Directory publishing, OpenTelemetry semantic attributes, and the CASA intent compiler.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/agntcy"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/oasf/taxonomy.generated.json','dist/oasf/taxonomy.generated.json')\"",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "metaharness",
    "agntcy",
    "oasf",
    "agent-directory",
    "did",
    "verifiable-credentials",
    "opentelemetry",
    "observability",
    "casa",
    "agent-identity",
    "provenance",
    "agent-harness"
  ],
  "author": "rUv <ruv@ruv.net>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "agntcy-dir": "^1.8.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
