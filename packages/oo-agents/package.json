{
  "name": "@metaharness/oo-agents",
  "version": "0.1.1",
  "description": "Object-oriented agents with a Rust/WASM code-as-action sandbox: the agent is a class, methods are capabilities, and the model acts by writing code in a fuel-limited cell VM.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/oo-agents"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "metaharness",
    "oo-agents",
    "nooa",
    "code-as-action",
    "wasm-sandbox",
    "object-oriented",
    "agent-harness",
    "typescript"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@metaharness/radio": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  }
}
