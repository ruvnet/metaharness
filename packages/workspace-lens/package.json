{
  "name": "@metaharness/workspace-lens",
  "version": "0.1.3",
  "description": "Jacobian-Lens interpretability for open-weight LLMs: read a model's workspace at inference time into tokens, layer trajectory, drift and entropy scores, safety flags and a signable receipt.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/workspace-lens"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "bench": "npm run build && node bench/detect-concepts-throughput.mjs"
  },
  "keywords": [
    "metaharness",
    "jacobian-lens",
    "interpretability",
    "logit-lens",
    "global-workspace",
    "mechanistic-interpretability",
    "ai-safety",
    "prompt-injection",
    "open-weight",
    "llm",
    "agent-harness"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  }
}
