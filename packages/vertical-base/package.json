{
  "name": "@metaharness/vertical-base",
  "version": "0.1.1",
  "description": "Shared contract for @metaharness/vertical-* packs: the VerticalPack interface, manifest schema and template-files protocol.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/vertical-base"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
