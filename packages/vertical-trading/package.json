{
  "name": "@metaharness/vertical-trading",
  "version": "0.1.1",
  "description": "Trading vertical pack for MetaHarness: paper mode by default, circuit breakers, fractional-Kelly sizing, and a five-agent pipeline from market watcher to postmortem.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/metaharness.git",
    "directory": "packages/vertical-trading"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/metaharness/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "templates/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "metaharness",
    "agent-harness",
    "vertical-pack",
    "trading",
    "paper-trading",
    "quant",
    "risk-management",
    "circuit-breaker",
    "kelly-criterion"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metaharness/vertical-base": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
