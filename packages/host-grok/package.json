{
  "name": "@metaharness/host-grok",
  "version": "0.1.0",
  "description": "xAI Grok Build CLI host adapter for agent-harness-generator. Emits .grok/config.toml ([mcp_servers] + [permission]), AGENTS.md, .grok/agents, .grok/skills and .grok/hooks (ADR-280).",
  "homepage": "https://github.com/ruvnet/agent-harness-generator",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/agent-harness-generator.git",
    "directory": "packages/host-grok"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "agent-harness",
    "grok",
    "grok-build",
    "xai",
    "mcp",
    "host-adapter",
    "ruflo",
    "ADR-280"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metaharness/kernel": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
