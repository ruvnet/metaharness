 static size_t align8(size_t x) { return (x + 7u) & ~(size_t)7u; }
 
+/* Widen n bf16 elements to fp32. The widen is an exact 16-bit left shift (k3_bf16f)
+ * applied elementwise with no accumulation, so any vector width, chunking or thread
+ * count produces byte-identical output. The OpenMP `if` clause keeps the small
+ * norm/bias vectors serial; only the big matrices (router gate is 6.42M elements)
+ * fan out. */
+static void widen_bf16(float *dst, const uint16_t *sp, int64_t n)
+{
+#if defined(__AVX2__)
+    const int64_t nv = n & ~(int64_t)7;
+#pragma omp parallel for schedule(static) if (n > 65536)
+    for (int64_t k = 0; k < nv; k += 8) {
+        __m128i h = _mm_loadu_si128((const __m128i *)(sp + k));
+        __m256i f = _mm256_slli_epi32(_mm256_cvtepu16_epi32(h), 16);
+        _mm256_storeu_si256((__m256i *)(dst + k), f);
+    }
+    for (int64_t k = nv; k < n; k++) dst[k] = k3_bf16f(sp[k]);
+#else
+#pragma omp parallel for schedule(static) if (n > 65536)
+    for (int64_t k = 0; k < n; k++) dst[k] = k3_bf16f(sp[k]);
+#endif
+}
+
 /* Resolve and validate everything, and lay out the blob, before reading a byte. */
