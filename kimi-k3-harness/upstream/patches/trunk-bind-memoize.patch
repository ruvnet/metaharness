diff --git a/src/io/k3_trunk.h b/src/io/k3_trunk.h
index f8bdfc5..7870080 100644
--- a/src/io/k3_trunk.h
+++ b/src/io/k3_trunk.h
@@ -99,6 +99,21 @@ typedef struct {
      * layer name before its read succeeds; bind waits for completion before consuming it. */
     void         *io_state;
 
+    /* Memoised binds. Rebinding a RESIDENT layer re-runs tensor-name resolution plus
+     * the bf16->fp32 widen (~26 MB of convert+store for a MoE layer) only to reproduce
+     * a K3LayerBind identical to the previous one: every pointer in it targets the
+     * slot's own bytes, and those bytes have not moved. At a budget that pins most
+     * layers that is gigabytes of widen work per token recomputing known answers. So
+     * the finished bind is cached per pinned layer and per ring slot, and invalidated
+     * at every point where a slot's bytes are (re)loaded or a slot is claimed for a
+     * different layer. Identical bytes are served to compute either way, so output is
+     * bit-identical by construction; the only risk is stale invalidation, which is why
+     * claiming a slot clears its memo BEFORE any read is issued. */
+    K3LayerBind  *pin_bind;        /* [npin] finished bind per pinned layer            */
+    int          *pin_bind_ok;     /* [npin] 1 when pin_bind[i] matches the bytes      */
+    K3LayerBind  *slot_bind;       /* [nslot] finished bind per ring slot              */
+    int          *slot_bind_layer; /* [nslot] layer slot_bind[i] was built for, -1=none */
+
     /* stats */
     uint64_t     hits, misses;
     uint64_t     bytes_read;
