+ * k3_bind_layer_mem builds it), so after the value copy they are re-aimed at the
+ * caller's copy. NULL stays NULL: exactly one of kda/mla is set, matching the source. */
+static void bind_from_memo(K3LayerBind *b, const K3LayerBind *memo)
+{
+    *b = *memo;
+    b->lay.kda = b->lay.kda ? &b->kda : NULL;
+    b->lay.mla = b->lay.mla ? &b->mla : NULL;
+    b->lay.moe = b->lay.moe ? &b->moe : NULL;
